# Supabase — Project URL (REST/Auth)
VITE_SUPABASE_URL=https://dcbqsrxmdnhnzetovgjh.supabase.co

# Supabase — anon key (pública, pode ir para o build)
VITE_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# Conexão direta ao banco (NUNCA comitar; usar no backend/funções seguras)
# Cópia do painel Supabase: Project Settings > Database > Connection string > Session pooler
SUPABASE_DB_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Login local de demonstração (opcional; deixe vazio ou ausente em produção)
# Quando definido, habilita entrar como admin sem ter usuário no Supabase.
# ATENÇÃO: o Vite embute variáveis VITE_* no bundle do navegador. Isto NÃO é
# um segredo e não protege nada — os registros da demo vivem no localStorage.
# O controle de acesso de verdade será o RLS do Supabase. Deixe vazio no deploy
# público para que o acesso de demonstração fique desativado.
VITE_DEMO_ADMIN_PASSWORD=